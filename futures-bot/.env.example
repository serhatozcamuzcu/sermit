# Bu dosyayi .env olarak kopyalayin ve gercek degerlerinizi girin.
# .env dosyasini ASLA git'e commit etmeyin.

# Komut satirinda --exchange verilmezse kullanilacak varsayilan borsa.
EXCHANGE=binance

# --- Binance ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
# true  -> Binance Futures Testnet (sahte bakiye, risk yok, once burada test edin)
# false -> Gercek hesap (mainnet), gercek para ile islem yapar
BINANCE_TESTNET=true

# --- MEXC ---
MEXC_API_KEY=
MEXC_API_SECRET=
# MEXC icin ccxt sandbox/testnet destegi sinirlidir. true birakin;
# destek yoksa program sizi uyarip gercek hesapla devam eder.
MEXC_TESTNET=true
